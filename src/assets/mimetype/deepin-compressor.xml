<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
	<mime-type type="application/x-7z-compressed">
		<comment>Compressed 7z</comment>
		<generic-icon name="deepin-compressor"/>
		<glob pattern="*.7z.*" weight="80"/>
	</mime-type>
	<mime-type type="application/vnd.linglong.layer">
		<comment>Linglong layer package</comment>
		<comment xml:lang="zh_CN">如意玲珑 layer 软件包</comment>
		<glob pattern="*.layer" weight="80"/>
		<magic priority="90">
			<match value="&lt;&lt;&lt; deepin linglong layer archive &gt;&gt;&gt;" type="string" offset="0"/>
		</magic>
	</mime-type>
</mime-info>

